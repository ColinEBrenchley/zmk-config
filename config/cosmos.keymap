#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |  6   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |  Y   |
// |  CTRL |  A  |  S  |  D   |  F   |  G   |  H   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  N   |
// |  ALT  | LGUI| LOWER|  SPACE  |  RAISE | BSPC |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5   &kp N6
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T    &kp Y
&kp LCTRL &kp A  &kp S  &kp D    &kp F    &kp G    &kp H
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B    &kp N
&kp LALT  &kp LGUI &mo 1 &kp SPACE       &mo 2    &kp BSPC
            >;
        };

        lower_layer {
// -----------------------------------------------------------------------
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |  F7  |
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |  F8  |
// |   `   |  !  |  @  |  #   |  $   |  %   |  ^   |
// |       |     |     |      |      |      |  &   |
// |       |     |     |        |      |      |
            bindings = <
&bt BT_CLR &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3 &bt BT_SEL 4 &kp F7
&kp F1     &kp F2           &kp F3            &kp F4            &kp F5       &kp F6       &kp F8
&kp GRAVE  &kp EXCL         &kp AT            &kp HASH          &kp DOLLAR   &kp PRCNT    &kp CARET
&trans     &ext_power EP_ON &ext_power EP_OFF &ext_power EP_TOG &trans       &trans       &kp AMPS
&trans     &trans           &trans            &trans                         &trans       &trans
            >;
        };

        raise_layer {
// -----------------------------------------------------------------------
// |       |     |     |      |      |      |      |
// |   `   |  1  |  2  |  3   |  4   |  5   |  6   |
// |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |  <-  |
// |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |  ^   |
// |       |     |     |        |      | DOWN |
            bindings = <
&trans    &trans &trans &trans  &trans  &trans  &trans
&kp GRAVE &kp N1 &kp N2 &kp N3  &kp N4  &kp N5  &kp N6
&kp LCTRL &kp F2 &kp F3 &kp F4  &kp F5  &kp F6  &kp LEFT
&kp F7    &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp UP
&trans    &trans &trans &trans              &kp DOWN &trans
            >;
        };
    };
};
