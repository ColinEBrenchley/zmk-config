/*
 * Cosmos Keyboard — Keymap
 * 5 rows x 14 cols (7 per half)
 * Layers: Base (QWERTY), Lower, Raise, Adjust
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ─── Layer 0: Base (QWERTY) ─────────────────────────────────────
         * ┌──────┬──────┬──────┬──────┬──────┬──────┬──────┐  ┌──────┬──────┬──────┬──────┬──────┬──────┬──────┐
         * │ ESC  │  1   │  2   │  3   │  4   │  5   │  6   │  │  7   │  8   │  9   │  0   │  -   │  =   │ BSPC │
         * ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤  ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤
         * │ TAB  │  Q   │  W   │  E   │  R   │  T   │  [   │  │  ]   │  Y   │  U   │  I   │  O   │  P   │  \   │
         * ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤  ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤
         * │ CAPS │  A   │  S   │  D   │  F   │  G   │  (   │  │  )   │  H   │  J   │  K   │  L   │  ;   │  '   │
         * ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤  ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤
         * │LSHFT │  Z   │  X   │  C   │  V   │  B   │  {   │  │  }   │  N   │  M   │  ,   │  .   │  /   │RSHFT │
         * ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤  ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤
         * │ LCTL │ LGUI │ LALT │  `   │LOWER │ SPC  │ DEL  │  │ ENT  │ SPC  │RAISE │ LEFT │ DOWN │  UP  │RIGHT │
         * └──────┴──────┴──────┴──────┴──────┴──────┴──────┘  └──────┴──────┴──────┴──────┴──────┴──────┴──────┘
         */
        base_layer {
            bindings = <
                &kp ESC   &kp N1   &kp N2   &kp N3    &kp N4    &kp N5                  &kp N6     &kp N7   &kp N8    &kp N9    &kp N0    &kp BSPC  &kp RET         &kp RET 
                &kp TAB   &kp Q    &kp W    &kp E     &kp R     &kp T                   &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSLH  &kp RGUI        &kp RBKT
                &kp CLCK  &kp A    &kp S    &kp D     &kp F     &kp G                   &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp LPAR        &kp RPAR
                &kp LSHFT &kp Z    &kp X    &kp C     &kp V     &kp B                   &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp RCTRL       &kp RBRC
                &kp LCTRL &kp LGUI &kp LALT &kp GRAVE &mo LOWER &kp SPACE               &kp DEL   &kp RET   &kp LEFT  &kp RIGHT &kp LEFT  &kp DOWN  &mo RAISE       &kp RIGHT
            >;          
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        /* ─── Layer 1: Lower — Symbols & F-Keys ─────────────────────────*/
        lower_layer {
            bindings = <
                &kp GRAVE &kp F1   &kp F2   &kp F3   &kp F4   &kp F5               &kp F7   &kp F8   &kp F9   &kp F10  &kp F11  &kp F12  &kp DEL
                &trans    &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT             &trans   &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR &trans
                &trans    &trans   &trans   &trans   &trans   &trans                &trans   &kp MINUS &kp PLUS &kp LBRC &kp RBRC &kp PIPE &kp TILDE
                &trans    &trans   &trans   &trans   &trans   &trans                &trans   &kp UNDER &kp EQUAL &kp LBKT &kp RBKT &kp BSLH &trans
                &trans    &trans   &trans   &trans   &trans   &trans          &trans   &trans   &trans   &kp HOME &kp PG_DN &kp PG_UP &kp END
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        /* ─── Layer 2: Raise — Navigation & Numpad ───────────────────────*/
        raise_layer {
            bindings = <
                &trans    &trans   &trans   &trans   &trans   &trans                &trans   &trans   &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MINUS &trans
                &trans    &trans   &trans   &trans   &trans   &trans                &trans   &trans   &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_PLUS  &trans
                &trans    &trans   &trans   &trans   &trans   &trans                &trans   &trans   &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_ENTER &trans
                &trans    &trans   &trans   &trans   &trans   &trans                &trans   &trans   &kp KP_N0 &trans    &kp KP_DOT &trans       &trans
                &trans    &trans   &trans   &trans   &trans   &trans          &trans   &trans   &trans   &kp HOME &kp PG_DN &kp PG_UP &kp END
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        /* ─── Layer 3: Adjust — BT & System (LOWER + RAISE) ─────────────*/
        adjust_layer {
            bindings = <
                &bootloader &none      &none      &none      &none      &none      &none       &none      &none      &none      &none      &none        &sys_reset
                &none      &none      &none      &none      &none      &none      &none        &none      &none      &none      &none      &none        &none
                &none      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none  &none      &none      &none      &none      &none        &none
                &none      &none      &none      &none      &none      &bt BT_CLR &none        &none      &none      &none      &none      &none        &none
                &none      &none      &none      &none      &none      &none      &none        &none      &none      &none      &none      &none        &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
