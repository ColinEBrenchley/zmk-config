/*
 * Cosmos Keyboard - Right Half
 * Board: nice!nano v2 (nRF52840)
 * Matrix: 5 rows x 7 cols (right side)
 * Split: BLE peripheral
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "cosmos.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        /*
         * nice!nano v2 pinout — Right Half
         * Same physical pins, mirrored layout
         * Rows: P0.31, P0.29, P0.02, P1.15, P1.13
         * Cols: P0.10, P0.24, P1.00, P0.11, P1.04, P1.06, P0.09
         */
        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio0 10 GPIO_ACTIVE_HIGH>   /* col 6 → outermost */
            , <&gpio1  6 GPIO_ACTIVE_HIGH>   /* col 1 */
            , <&gpio1  4 GPIO_ACTIVE_HIGH>   /* col 2 */
            , <&gpio0 11 GPIO_ACTIVE_HIGH>   /* col 3 */
            , <&gpio1  0 GPIO_ACTIVE_HIGH>   /* col 4 */
            , <&gpio0 24 GPIO_ACTIVE_HIGH>   /* col 5 */
            , <&gpio0  9 GPIO_ACTIVE_HIGH>   /* col 0 → innermost (closest to center) */
            ;
    };
};


&default_transform {
    col-offset = <7>;
};
