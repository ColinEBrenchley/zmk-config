#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;  /* 7 cols per half x 2 */
        rows = <5>;

        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)              RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) 
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)              RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) 
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)              RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) 
            RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)              RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11) RC(3,12) 
            RC(4,2)  RC(4,3)  RC(4,6)  RC(3,6)  RC(0,6)  RC(2,6)              RC(4,9)  RC(4,10) RC(4,13) RC(0,13) RC(1,13) RC(3,13)
        >;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   75       0     0     0>
            , <&key_physical_attrs 100 100  100   75       0     0     0>
            , <&key_physical_attrs 100 100  200   20       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400   25       0     0     0>
            , <&key_physical_attrs 100 100  500   30       0     0     0>
            , <&key_physical_attrs 100 100  950   30       0     0     0>
            , <&key_physical_attrs 100 100 1050   25       0     0     0>
            , <&key_physical_attrs 100 100 1150    0       0     0     0>
            , <&key_physical_attrs 100 100 1250   20       0     0     0>
            , <&key_physical_attrs 100 100 1350   75       0     0     0>
            , <&key_physical_attrs 100 100 1450   75       0     0     0>
            , <&key_physical_attrs 100 100    0  175       0     0     0>
            , <&key_physical_attrs 100 100  100  175       0     0     0>
            , <&key_physical_attrs 100 100  200  120       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  125       0     0     0>
            , <&key_physical_attrs 100 100  500  130       0     0     0>
            , <&key_physical_attrs 100 100  950  130       0     0     0>
            , <&key_physical_attrs 100 100 1050  125       0     0     0>
            , <&key_physical_attrs 100 100 1150  100       0     0     0>
            , <&key_physical_attrs 100 100 1250  120       0     0     0>
            , <&key_physical_attrs 100 100 1350  175       0     0     0>
            , <&key_physical_attrs 100 100 1450  175       0     0     0>
            , <&key_physical_attrs 100 100    0  275       0     0     0>
            , <&key_physical_attrs 100 100  100  275       0     0     0>
            , <&key_physical_attrs 100 100  200  220       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  225       0     0     0>
            , <&key_physical_attrs 100 100  500  230       0     0     0>
            , <&key_physical_attrs 100 100  950  230       0     0     0>
            , <&key_physical_attrs 100 100 1050  225       0     0     0>
            , <&key_physical_attrs 100 100 1150  200       0     0     0>
            , <&key_physical_attrs 100 100 1250  220       0     0     0>
            , <&key_physical_attrs 100 100 1350  275       0     0     0>
            , <&key_physical_attrs 100 100 1450  275       0     0     0>
            , <&key_physical_attrs 100 100    0  375       0     0     0>
            , <&key_physical_attrs 100 100  100  375       0     0     0>
            , <&key_physical_attrs 100 100  200  320       0     0     0>
            , <&key_physical_attrs 100 100  300  300       0     0     0>
            , <&key_physical_attrs 100 100  400  325       0     0     0>
            , <&key_physical_attrs 100 100  500  330       0     0     0>
            , <&key_physical_attrs 100 100  950  330       0     0     0>
            , <&key_physical_attrs 100 100 1050  325       0     0     0>
            , <&key_physical_attrs 100 100 1150  300       0     0     0>
            , <&key_physical_attrs 100 100 1250  320       0     0     0>
            , <&key_physical_attrs 100 100 1350  375       0     0     0>
            , <&key_physical_attrs 100 100 1450  375       0     0     0>
            , <&key_physical_attrs 100 100  200  420       0     0     0>
            , <&key_physical_attrs 100 100  300  400       0     0     0>
            , <&key_physical_attrs 100 100 1150  400       0     0     0>
            , <&key_physical_attrs 100 100 1250  420       0     0     0>
            , <&key_physical_attrs 100 100  450  475     900   400   200>
            , <&key_physical_attrs 100 125  550  455    1700   475   400>
            , <&key_physical_attrs 100 100  550  605    1500   375   500>
            , <&key_physical_attrs 100 100  650  475    3000   500   500>
            , <&key_physical_attrs 100 100  900  475 (-3000)  1000   750>
            , <&key_physical_attrs 100 125 1000  455 (-1500)  1100   900>
            , <&key_physical_attrs 100 100 1000  605 (-1700)  1150  1000>
            , <&key_physical_attrs 100 100 1090  455  (-900)  1300  1000>
            ;
    };
};

&default_layout {
    transform = <&default_transform>;
};