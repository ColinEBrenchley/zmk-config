#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define ADJUST 3
#define GAMING 4

/* Include the combined behaviors file */
#include "6x6_behaviors.dtsi"

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <NAV NUM>;
            then-layer = <ADJUST>;    // now correctly separate
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
            &kp Q     &kp W       &kp E       &kp R       &kp T              &kp Y       &kp U     &kp I      &kp O     &kp P   
            &kp A     &kp S       &kp D       &kp F       &kp G              &kp H       &kp J     &kp K      &kp L     
            &kp Z     &kp X       &kp C       &kp V       &kp B              &kp N       &kp M     &kp COMMA  &kp DOT   &kp FSLH
                                  &kp LSHFT   &mo NAV      &kp SPACE         &kp ENTER   &mo NUM  &kp RSHFT  
            >;
        };

        nav_layer {
            bindings = <
            &swapper    &kp W       &kp E       &kp R       &kp T              &kp Y     &kp U     &kp I      &kp O     &kp BSPC   
            &kp TAB     &kp S       &kp D       &kp F       &kp G              &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT     
            &kp LCTL    &kp X       &kp C       &kp V       &kp B              &kp N     &kp M     &kp COMMA  &kp DOT   &kp FSLH
            &kp LSHFT               &mo NAV                  &kp SPACE          &kp ENTER           &mo NUM               &kp RSHFT  
            >;
        };

        num_layer {
            bindings = <
            &kp N1      &kp N2      &kp N3      &kp N4      &kp N5             &kp N6    &kp N7    &kp N8     &kp N9    &kp N0  
            &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT          &kp CARET &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR      
            &kp LCTL    &kp X       &kp C       &kp V       &kp B              &kp N     &kp M     &kp COMMA  &kp DOT   &kp FSLH
            &kp LSHFT               &mo NAV                  &kp SPACE          &kp ENTER           &mo NUM               &kp RSHFT  
            >;
        };

        adjust_layer {
            bindings = <
            &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3          &kp N6       &kp N7        &kp N8          &kp PRINTSCREEN  &bootloader 
            &kp EXCL    &kp AT        &kp HASH      &kp DLLR       &kp PRCNT             &kp CARET    &kp AMPS      &kp ASTRK       &kp LPAR         &kp RPAR      
            &kp LCTL    &kp X         &kp C         &kp V          &kp B                 &kp N        &kp M         &kp COMMA       &kp DOT          &kp FSLH
            &kp LSHFT                 &mo NAV                      &kp SPACE             &kp ENTER                  &mo NUM                          &kp LALT  
            >;   
        };

        gaming_layer {
            bindings = <
            &kp ESC    &kp Q     &kp W       &kp E       &kp R                   &kp Y       &kp U     &kp I      &kp O     &kp P   
            &kp TAB    &kp A     &kp S       &kp D       &kp F                   &kp H       &kp J     &kp K      &kp L     
            &kp LCTL   &kp Z     &kp X       &kp C       &kp V                   &kp N       &kp M     &kp COMMA  &kp DOT   &kp FSLH
            &kp LSHFT            &mo NAV                 &kp SPACE               &kp ENTER             &mo NUM              &kp LALT  
            >;   
        };
    };
};
