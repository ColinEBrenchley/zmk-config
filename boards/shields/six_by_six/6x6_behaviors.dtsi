#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
    };

    combos {
        compatible = "zmk,combos";

        toggle_gaming {
            timeout-ms = <100>;
            key-positions = <0 9>;
            bindings = <&tog GAMING>;
            layers = <BASE>;
        };
        
        toggle_gaming_off {
            timeout-ms = <100>;
            key-positions = <0 9>;
            bindings = <&to BASE>;
            layers = <GAMING>;
        };
    };
};