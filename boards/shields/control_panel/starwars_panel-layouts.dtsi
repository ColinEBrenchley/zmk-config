/*
 * Matrix transform + physical layout.
 *
 * Key position N in the keymap = Nth entry in `map`.
 * Matrix order (row-major) is kept so wiring stays trivial; if your panel
 * wires differently, only edit the RC() entries here.
 *
 *   pos 0-8   : 9-key number cluster  -> R0C0..R0C4, R1C0..R1C3
 *   pos 9-12  : 4-key group           -> R1C4, R2C0..R2C2
 *   pos 13-14 : 2-key group A         -> R2C3, R2C4
 *   pos 15-16 : 2-key group B         -> R3C0, R3C1
 *   pos 17-18 : 2-key group C         -> R3C2, R3C3
 *   pos 19-22 : 4-key group           -> R3C4, R4C0..R4C2
 *   pos 23-24 : flip switches A and B, wired into the matrix -> R1C0, R2C0
 *
 * The physical layout below is a PLACEHOLDER grid (units of 1/100 key) used by
 * tools like ZMK Studio / keymap editors. Edit x/y to match your real panel.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
	chosen {
		zmk,physical-layout = &physical_layout0;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <5>;
		rows = <5>;
		map = <
				RC(3,0)			RC(3,4)
			RC(3,1) RC(3,2) RC(3,3) RC(2,4)
			RC(2,1) RC(2,2) RC(2,3)
			RC(1,1) RC(1,2) RC(1,3) RC(1,4)
				RC(4,3) 	RC(4,4)

			RC(0,4) RC(0,2)
			RC(0,3) RC(0,1)
			RC(0,0) RC(4,0) RC(4,1) RC(4,2)
			RC(1,0) RC(2,0)
		>;
	};

	physical_layout0: physical_layout_0 {
		compatible = "zmk,physical-layout";
		display-name = "Star Wars Panel";
		transform = <&default_transform>;

		/*                  w   h    x    y  rot rx ry */
		keys  // 9-key cluster (3x3), pos 0-8
			= <&key_physical_attrs 100 100   0   0 0 0 0>
			, <&key_physical_attrs 100 100 100   0 0 0 0>
			, <&key_physical_attrs 100 100 200   0 0 0 0>
			, <&key_physical_attrs 100 100   0 100 0 0 0>
			, <&key_physical_attrs 100 100 100 100 0 0 0>
			, <&key_physical_attrs 100 100 200 100 0 0 0>
			, <&key_physical_attrs 100 100   0 200 0 0 0>
			, <&key_physical_attrs 100 100 100 200 0 0 0>
			, <&key_physical_attrs 100 100 200 200 0 0 0>
			// 4-key group, pos 9-12
			, <&key_physical_attrs 100 100 400   0 0 0 0>
			, <&key_physical_attrs 100 100 500   0 0 0 0>
			, <&key_physical_attrs 100 100 600   0 0 0 0>
			, <&key_physical_attrs 100 100 700   0 0 0 0>
			// 2-key group A, pos 13-14
			, <&key_physical_attrs 100 100 400 100 0 0 0>
			, <&key_physical_attrs 100 100 500 100 0 0 0>
			// 2-key group B, pos 15-16
			, <&key_physical_attrs 100 100 600 100 0 0 0>
			, <&key_physical_attrs 100 100 700 100 0 0 0>
			// 2-key group C, pos 17-18
			, <&key_physical_attrs 100 100 400 200 0 0 0>
			, <&key_physical_attrs 100 100 500 200 0 0 0>
			// 4-key group, pos 19-22
			, <&key_physical_attrs 100 100   0 300 0 0 0>
			, <&key_physical_attrs 100 100 100 300 0 0 0>
			, <&key_physical_attrs 100 100 200 300 0 0 0>
			, <&key_physical_attrs 100 100 300 300 0 0 0>
			// Matrix toggle switches A and B, pos 23-24
			, <&key_physical_attrs 100 100 600 200 0 0 0>
			, <&key_physical_attrs 100 100 700 200 0 0 0>
			;
	};
};
