/*
 * LED effect behaviors (implemented in src/led_fx.c + src/behavior_led_fx.c).
 * The numbers below MUST match enum led_fx_cmd in src/led_fx.h.
 *
 *   &fx FX_RED       solid red (default; also selects the red palette)
 *   &fx FX_ALERT     flashing selected color; press again to return to solid
 *   &fx FX_CHASE     selected-color base with a bright pulse
 *   &fx FX_BREATHE   slow breathing in the selected color
 *   &fx FX_SCANNER   scanner in the selected color
 *   &fx FX_OFF       LEDs off
 *   &fx FX_SWEEP     one-shot bright pulse in the selected color, then back to the current effect
 *   &fx FX_WAVE      one-shot dark pulse across the strip, restoring each LED's current color
 *   &fx FX_NEXT      cycle to the next effect
 *   &fx FX_RANDOM    select a random non-off effect different from the current one
 *   &fx FX_GREEN     select the green palette and solid effect
 *   &fx FX_BRI_UP / FX_BRI_DN   brightness (the encoder wrapper below uses these)
 */

#define FX_RED     0
#define FX_ALERT   1
#define FX_CHASE   2
#define FX_BREATHE 3
#define FX_SCANNER 4
#define FX_OFF     5
#define FX_SWEEP   6
#define FX_NEXT    7
#define FX_BRI_UP  8
#define FX_BRI_DN  9
#define FX_WAVE    10
#define FX_RANDOM  11
#define FX_GREEN   12

/ {
	behaviors {
		fx: led_fx {
			compatible = "zmk,behavior-led-fx";
			#binding-cells = <1>;
			display-name = "LED FX";
		};

		b_random_mode: b_random_mode {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			display-name = "B + Random LED Mode";
			bindings =
				<&macro_tap &kp B>,
				<&macro_tap &fx FX_RANDOM>;
		};

		/* Encoder-friendly brightness: clockwise = up, counter-clockwise = down */
		fx_bri: fx_bri {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&fx FX_BRI_UP>, <&fx FX_BRI_DN>;
		};
	};
};
